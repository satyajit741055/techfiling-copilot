# =============================================================================
# TechFiling Copilot Frontend - Environment Configuration
# =============================================================================
# Copy this file to .env.local and configure for your environment.
# The .env.local file should NOT be committed to version control.
#
# Usage:
#   cp .env.local.example .env.local
#   # Edit .env.local with your settings
# =============================================================================

# =============================================================================
# API CONFIGURATION
# =============================================================================

# The browser only calls this app's own /api/* routes. Those server-side routes
# forward to the backend and add the API key, so neither value below is ever
# sent to the browser (do NOT prefix them with NEXT_PUBLIC_).

# Backend URL, reachable from the Next.js server
# Development: http://localhost:8000
# Docker Compose: http://backend:8000 (set by docker-compose.yml)
BACKEND_URL=http://localhost:8000

# Must match API_ACCESS_KEY in the backend .env (required when ENVIRONMENT=prod;
# leave empty in dev if the backend has no key)
API_ACCESS_KEY=

# =============================================================================
# OPTIONAL: ANALYTICS & MONITORING
# =============================================================================

# Google Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking (optional)
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# =============================================================================
# OPTIONAL: FEATURE FLAGS
# =============================================================================

# Enable demo mode (shows sample questions prominently)
# NEXT_PUBLIC_DEMO_MODE=true

# Enable analytics dashboard (requires authentication)
# NEXT_PUBLIC_ENABLE_ANALYTICS=false

# =============================================================================
# FUTURE: AUTHENTICATION (Supabase)
# =============================================================================
# These will be used when authentication is implemented

# Supabase project URL
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# Supabase anonymous key (safe for frontend)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
