# =============================================================================
# TechFiling Copilot - Environment Configuration (local model mode)
# =============================================================================
# Embedding + reranker run on DEVICE from MODEL_CACHE_DIR, generation and the research
# agent run on Ollama (qwen2.5-7b), retrieval on Docker Qdrant. Nothing calls an API.
# For Hugging Face API mode use .env.example. See .env.example for every option.
#
# Usage:
#   Copy-Item .env.local.example .env       (bash: cp .env.local.example .env)
#   # Then set API_ACCESS_KEY (same value as the web proxy) if you use auth
#   docker compose up -d qdrant
#   uv run uvicorn api.main:app --host 0.0.0.0 --port 8000 --env-file .env
# --env-file is needed for HF_HUB_OFFLINE / TRANSFORMERS_OFFLINE below: they are read
# from the process environment, which the app settings do not populate.
# =============================================================================

ENVIRONMENT=dev

# =============================================================================
# API SECURITY
# =============================================================================
# Optional in dev; REQUIRED in prod (24+ chars), plus an explicit CORS_ORIGINS list.
API_ACCESS_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Per-user auth: the backend verifies Supabase tokens using the project's public keys,
# fetched from NEXT_PUBLIC_SUPABASE_URL (below; or set SUPABASE_URL explicitly).
# SUPABASE_JWT_SECRET is only needed for legacy projects that still sign tokens with the
# shared HS256 secret (Project Settings > API); leave empty for asymmetric (ES256/RS256) keys.
SUPABASE_JWT_SECRET=

# Supabase frontend configuration (for web/.env.local)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =============================================================================
# RATE LIMITING
# =============================================================================
# Leave unset for in-memory storage (no Redis required)
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_QUESTIONS_PER_MINUTE=10
# Leave unset to use RATE_LIMIT_QUESTIONS_PER_MINUTE.
# RATE_LIMIT_CHAT_PER_MINUTE=10
RATE_LIMIT_FILINGS_PER_MINUTE=30
RATE_LIMIT_GLOBAL_PER_MINUTE=100

# =============================================================================
# MODEL EXECUTION MODE
# =============================================================================
# All model inference runs locally.
MODEL_EXECUTION_MODE=local
EMBEDDING_EXECUTION_MODE=
RERANKER_EXECUTION_MODE=
GENERATION_EXECUTION_MODE=

# Load embedding/reranker models only from MODEL_CACHE_DIR: no huggingface.co calls
# (a corporate SSL proxy breaks them). Download the models once with these set to 0.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# =============================================================================
# LLM CONFIGURATION (Ollama)
# =============================================================================
LLM_PROVIDER=ollama
# LLM_MODEL=
OLLAMA_MODEL=qwen2.5-7b-instruct:latest
OLLAMA_HOST=http://localhost:11434
# Research synthesis prompts are ~9k tokens; keep this >= 16384.
OLLAMA_NUM_CTX=16384
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Other provider defaults (unused in local mode unless explicitly selected).
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GOOGLE_MODEL=gemini-1.5-pro

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================
# Leave provider/model empty to inherit the generation provider and its model.
AGENT_LLM_PROVIDER=
AGENT_LLM_MODEL=
AGENT_MAX_TASKS=10
AGENT_MAX_REPLANS=2
AGENT_MAX_TOOL_STEPS=2
AGENT_TASK_K=5
AGENT_MAX_CONTEXT_CHUNKS=24
# Disabled until calibrated against negative retrieval goldens.
AGENT_MIN_EVIDENCE_SCORE=
AGENT_RETRIEVAL_CONCURRENCY=2
AGENT_LLM_CONCURRENCY=2
AGENT_TIMEOUT_SECONDS=180
# Debug trace of /chat turns: off | errors | all (see .env.example). "all" logs one line per
# LLM call / retrieval / node / decision to logs/app.log and writes every turn to
# AGENT_TRACE_DIR/<time>_<turn id>.json (full prompts, raw outputs, hits, errors).
AGENT_TRACE=all
AGENT_TRACE_DIR=logs/agent_traces

# =============================================================================
# POSTGRES: CONVERSATION HISTORY + RESEARCH-CHAT CHECKPOINTS
# =============================================================================
# Docker Postgres (once):
#   docker compose --profile history up -d postgres
#   uv run python scripts/apply_migrations.py
# Set a URL-safe password (python -c "import secrets; print(secrets.token_urlsafe(24))")
# in both POSTGRES_PASSWORD and HISTORY_DB_URL. See .env.example for Supabase.
POSTGRES_PASSWORD=
HISTORY_DB_URL=postgresql://techfiling:<POSTGRES_PASSWORD>@127.0.0.1:5432/techfiling
# Options: none | postgres
HISTORY_STORE=postgres
# Dev only (auth off): fixed UUID that owns saved history
# (python -c "import uuid; print(uuid.uuid4())")
HISTORY_DEV_USER_ID=
# memory | postgres: postgres keeps clarification pauses and follow-up context across
# restarts. Unreachable database at startup -> /chat disabled (503), /questions works.
AGENT_CHECKPOINTER=postgres
# off | postgres: reported XBRL figures for numeric answers (see .env.example).
# Fill with: uv run python scripts/load_facts.py
FACTS_STORE=postgres

# =============================================================================
# EMBEDDING & RETRIEVAL MODELS (local)
# =============================================================================
DEVICE=auto
# Must match the model the Qdrant collection was embedded with.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=cross-encoder/ettin-reranker-150m-v1
RERANKER_MODEL_PROD=cross-encoder/ettin-reranker-150m-v1
MODEL_CACHE_DIR=models/sentence_transformers

# Retrieval configuration.
RETRIEVAL_ALPHA=0.7
RETRIEVAL_K=50
CONTEXT_K=5

# =============================================================================
# VECTOR STORE
# =============================================================================
# docker-compose.yml overrides QDRANT_URL for the backend container.
VECTOR_STORE=qdrant
QDRANT_URL=http://127.0.0.1:6333
# Embedded on-disk Qdrant (no Docker); overrides QDRANT_URL when set.
QDRANT_PATH=
QDRANT_COLLECTION=techfiling_20261031T133214Z
# QDRANT_API_KEY=
# QDRANT_TIMEOUT=30

# =============================================================================
# PATHS
# =============================================================================
DATA_DIR=data
CHUNKS_DIR=data/chunks
# Ingestion run behind QDRANT_COLLECTION (bge-base-en-v1.5, 7563 chunks)
RUN_DIRECTORY=data/chunks/2026-10-31_19-00-27

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
# text: readable lines with [req=... turn=...] ids; json for a log collector (see .env.example)
LOG_FORMAT=text
LOG_FILE=logs/app.log

# =============================================================================
# EVALUATION
# =============================================================================
# DeepEval still uses an OpenAI judge when evaluations are run.
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPEVAL_JUDGE_MODEL=gpt-4o-mini

# =============================================================================
# OBSERVABILITY (latency / cost / reliability)
# =============================================================================
# One JSONL record per /questions request in METRICS_DIR/queries-YYYY-MM-DD.jsonl
METRICS_ENABLED=true
METRICS_DIR=logs/metrics
# First N requests per process are tagged cold (the one that loads the retriever always is)
METRICS_COLD_REQUESTS=2
# Retries of a failed LLM call (0 = off) with exponential backoff
LLM_MAX_RETRIES=0
LLM_RETRY_BACKOFF_SECONDS=1.0
# Override built-in token prices (USD per 1M tokens); local Ollama is free per token
# LLM_INPUT_PRICE_PER_1M=
# LLM_OUTPUT_PRICE_PER_1M=
# Hourly cost of the machine running local models (GPU VM, amortised workstation, ...)
LOCAL_COMPUTE_COST_PER_HOUR=0.0
