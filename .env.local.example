# TechFiling Copilot — local model mode
# Copy to .env: Copy-Item .env.local.example .env

ENVIRONMENT=dev

# All model inference runs locally.
MODEL_EXECUTION_MODE=local
EMBEDDING_EXECUTION_MODE=
RERANKER_EXECUTION_MODE=
GENERATION_EXECUTION_MODE=

# Local answer generation through Ollama.
LLM_PROVIDER=ollama
LLM_MODEL=
OLLAMA_MODEL=qwen2.5-7b-instruct:latest
OLLAMA_HOST=http://localhost:11434
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Other provider defaults (unused in local mode unless explicitly selected).
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GOOGLE_MODEL=gemini-1.5-pro

# Local embedding and reranking.
DEVICE=auto
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=cross-encoder/ettin-reranker-150m-v1
RERANKER_MODEL_PROD=cross-encoder/ettin-reranker-150m-v1
MODEL_CACHE_DIR=models/sentence_transformers

# Retrieval configuration.
RETRIEVAL_ALPHA=0.85
RETRIEVAL_K=50
CONTEXT_K=5

# Active chunk/embedding run.
DATA_DIR=data
CHUNKS_DIR=data/chunks
RUN_DIRECTORY=data/chunks/2026-10-20_16-33-24

# DeepEval still uses an OpenAI judge when evaluations are run.
# OPENAI_API_KEY=sk_your_actual_openai_key
DEEPEVAL_JUDGE_MODEL=gpt-4o-mini

LOG_LEVEL=INFO
