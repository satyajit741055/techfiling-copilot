# TechFiling Copilot — fully hosted Hugging Face API mode
# Copy to .env: Copy-Item .env.huggingface.example .env

ENVIRONMENT=dev

# API security (see .env.example). Optional in dev; REQUIRED in prod (24+ chars), plus an
# explicit CORS_ORIGINS list in prod.
API_ACCESS_KEY=
# CORS_ORIGINS=https://app.example.com

# Per-user auth: the backend verifies Supabase tokens using the project's public keys,
# fetched from NEXT_PUBLIC_SUPABASE_URL (below; or set SUPABASE_URL explicitly).
# SUPABASE_JWT_SECRET is only needed for legacy projects that still sign tokens with the
# shared HS256 secret (Project Settings > API); leave empty for asymmetric (ES256/RS256) keys.
SUPABASE_JWT_SECRET=

# Supabase frontend configuration (for web/.env.local)
# These are safe for the browser (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =============================================================================
# RATE LIMITING
# =============================================================================
# Redis URL for distributed rate limiting (production recommended).
# - dev:  Leave unset to use in-memory storage (no Redis required)
# - prod: Set to redis://localhost:6379/0 or redis://redis:6379/0 (Docker)
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/0

# Default rate limit per IP per minute (all endpoints)
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# Rate limit per IP per minute for /questions endpoint (expensive LLM calls)
RATE_LIMIT_QUESTIONS_PER_MINUTE=10

# Rate limit per IP per minute for /filings endpoint
RATE_LIMIT_FILINGS_PER_MINUTE=30

# Global rate limit across all IPs per minute (system protection)
RATE_LIMIT_GLOBAL_PER_MINUTE=100

# Embedding, reranking, and answer generation use Hugging Face APIs.
MODEL_EXECUTION_MODE=huggingface_api
EMBEDDING_EXECUTION_MODE=
RERANKER_EXECUTION_MODE=
GENERATION_EXECUTION_MODE=

# Required for every Hugging Face model stage.
HUGGINGFACE_API_KEY=hf_your_actual_token
HUGGINGFACE_TIMEOUT=120

# Answer generation through Hugging Face Inference Providers.
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
HUGGINGFACE_PROVIDER=auto
LLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Embeddings through the feature-extraction API.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
HUGGINGFACE_EMBEDDING_PROVIDER=hf-inference

# Reranking through the serverless endpoint.
RERANKER_MODEL=cross-encoder/ettin-reranker-150m-v1
RERANKER_MODEL_PROD=cross-encoder/ettin-reranker-150m-v1
HUGGINGFACE_RERANKER_URL=https://router.huggingface.co/hf-inference/models/{model}

# For a dedicated TEI endpoint, replace the previous URL with:
# HUGGINGFACE_RERANKER_URL=https://your-endpoint.endpoints.huggingface.cloud/rerank

# Retrieval configuration.
RETRIEVAL_ALPHA=0.85
RETRIEVAL_K=50
CONTEXT_K=5

# Vector store backend.
# - numpy:  embeddings_gpu_base.npy + in-memory BM25 from RUN_DIRECTORY (default)
# - qdrant: server-side dense + sparse hybrid search. Start it with
#           `docker compose up -d qdrant`, then load the run once with
#           `uv run python scripts/migrate_npy_to_qdrant.py`.
# docker-compose.yml overrides QDRANT_URL for the backend container.
VECTOR_STORE=numpy
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=filings_bge_base_v1
# QDRANT_API_KEY=
# QDRANT_TIMEOUT=30

# Existing local-built embeddings are sufficient for an initial smoke test but
# produce a backend-parity warning. For a controlled API run, regenerate the
# embeddings in API mode and point RUN_DIRECTORY to the new run.
DATA_DIR=data
CHUNKS_DIR=data/chunks
RUN_DIRECTORY=data/chunks/2026-10-24_12-46-23
MODEL_CACHE_DIR=models/sentence_transformers

# DeepEval judge through OpenAI.
OPENAI_API_KEY=sk_your_actual_openai_key
DEEPEVAL_JUDGE_MODEL=gpt-4o-mini

# Unused in full API mode; retained only as fallback provider defaults.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5-7b-instruct:latest
OLLAMA_HOST=http://localhost:11434
DEVICE=auto
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GOOGLE_MODEL=gemini-1.5-pro


# Optional: Write logs to file (uncomment to enable)
# LOG_FILE=src/logs/app.log
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# =============================================================================
# OBSERVABILITY (latency / cost / reliability)
# =============================================================================
# One JSONL record per /questions request in METRICS_DIR/queries-YYYY-MM-DD.jsonl
METRICS_ENABLED=true
METRICS_DIR=logs/metrics
# First N requests per process are tagged cold (the one that loads the retriever always is)
METRICS_COLD_REQUESTS=2
# Retries of a failed LLM call (0 = off) with exponential backoff
LLM_MAX_RETRIES=0
LLM_RETRY_BACKOFF_SECONDS=1.0
# Override built-in token prices (USD per 1M tokens); local Ollama is free per token
# LLM_INPUT_PRICE_PER_1M=
# LLM_OUTPUT_PRICE_PER_1M=
# Hourly cost of the machine running local models (GPU VM, amortised workstation, ...)
LOCAL_COMPUTE_COST_PER_HOUR=0.0