# =============================================================================
# TechFiling Copilot - Environment Configuration (Hugging Face API mode)
# =============================================================================
# Embedding, reranking, generation and the research agent all run on Hugging Face
# APIs; only Qdrant runs locally. For fully local models use .env.local.example.
# The .env file should NOT be committed to version control.
#
# Usage:
#   cp .env.example .env            (PowerShell: Copy-Item .env.example .env)
#   # Then set HUGGINGFACE_API_KEY (and API_ACCESS_KEY for the web proxy)
# =============================================================================

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Options: "dev" or "prod"
# - dev: Uses lighter models, more verbose logging
# - prod: Uses production-quality models, optimized settings
ENVIRONMENT=dev

# =============================================================================
# API SECURITY
# =============================================================================
# Shared secret required in the X-API-Key header on /questions and /filings.
# The Next.js server proxy adds it (set the same value as API_ACCESS_KEY for the
# frontend); it is never sent to the browser.
# - dev:  optional (auth disabled with a warning when empty)
# - prod: REQUIRED, 24+ characters (generate: openssl rand -hex 32)
API_ACCESS_KEY=

# Per-user auth: the backend verifies Supabase tokens using the project's public keys,
# fetched from NEXT_PUBLIC_SUPABASE_URL (below; or set SUPABASE_URL explicitly).
# SUPABASE_JWT_SECRET is only needed for legacy projects that still sign tokens with the
# shared HS256 secret (Project Settings > API); leave empty for asymmetric (ES256/RS256) keys.
SUPABASE_JWT_SECRET=

# Supabase frontend configuration (for web/.env.local)
# These are safe for the browser (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Allowed browser origins, comma-separated.
# - dev:  defaults to http://localhost:3000,http://127.0.0.1:3000 when unset
# - prod: REQUIRED and explicit; "*" and the localhost defaults are rejected
# CORS_ORIGINS=https://app.example.com

# =============================================================================
# RATE LIMITING
# =============================================================================
# Redis URL for distributed rate limiting (production recommended).
# - dev:  Leave unset to use in-memory storage (no Redis required)
# - prod: Set to redis://localhost:6379/0 or redis://redis:6379/0 (Docker)
# RATE_LIMIT_REDIS_URL=redis://localhost:6379/0

# Default rate limit per IP per minute (all endpoints)
RATE_LIMIT_DEFAULT_PER_MINUTE=60

# Rate limit per IP per minute for /questions endpoint (expensive LLM calls)
RATE_LIMIT_QUESTIONS_PER_MINUTE=10
# Leave unset to use RATE_LIMIT_QUESTIONS_PER_MINUTE.
# RATE_LIMIT_CHAT_PER_MINUTE=10

# Rate limit per IP per minute for /filings endpoint
RATE_LIMIT_FILINGS_PER_MINUTE=30

# Global rate limit across all IPs per minute (system protection)
RATE_LIMIT_GLOBAL_PER_MINUTE=100

# =============================================================================
# MODEL EXECUTION MODE
# =============================================================================
# Where the embedding model, reranker and generator run.
# - local:           embedding + reranker on DEVICE (CUDA/CPU), generator via LLM_PROVIDER
#                    (default ollama -> local Qwen)
# - huggingface_api: embedding, reranker and generator via Hugging Face APIs
#                    (requires HUGGINGFACE_API_KEY)
MODEL_EXECUTION_MODE=huggingface_api

# Optional per-component overrides (leave empty to follow MODEL_EXECUTION_MODE)
EMBEDDING_EXECUTION_MODE=
RERANKER_EXECUTION_MODE=
GENERATION_EXECUTION_MODE=

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# Generator provider used when generation runs in "local" mode.
# In "huggingface_api" mode the provider is always "huggingface".
# Options: "ollama" | "huggingface" | "openai" | "anthropic" | "google"
LLM_PROVIDER=huggingface

# Override the model for every provider (optional).
# Leave unset when switching modes so each provider uses its own default below.
# LLM_MODEL=

# Provider-specific default models (customize as needed)
OLLAMA_MODEL=qwen2.5-7b-instruct:latest
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GOOGLE_MODEL=gemini-1.5-pro

# Generation parameters
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# =============================================================================
# AGENT CONFIGURATION
# =============================================================================
# Leave provider/model empty to inherit the generation provider and its model.
AGENT_LLM_PROVIDER=
AGENT_LLM_MODEL=
AGENT_MAX_TASKS=10
AGENT_MAX_REPLANS=2
AGENT_MAX_TOOL_STEPS=2
AGENT_TASK_K=5
AGENT_MAX_CONTEXT_CHUNKS=24
# Disabled until calibrated against negative retrieval goldens.
AGENT_MIN_EVIDENCE_SCORE=
AGENT_RETRIEVAL_CONCURRENCY=2
AGENT_LLM_CONCURRENCY=2
# Whole-turn limit for POST /chat. The web proxy reads the same variable (web/.env.local)
# to size its upstream timeout.
AGENT_TIMEOUT_SECONDS=180
# Debug trace of /chat turns, one JSON file per turn in AGENT_TRACE_DIR (full prompts, raw
# model outputs, retrieval hits and scores, node updates, code decisions, errors, what the
# client received), named <time>_<turn id>.json and linked from the turn's summary log line.
# - off:    no traces
# - errors: production; trace only failed / timed-out / invalid / empty / trimmed turns
# - all:    local debugging; every turn, plus one log line per event
# Traces contain filing text and questions; keep them out of version control.
AGENT_TRACE=errors
AGENT_TRACE_DIR=logs/agent_traces

# =============================================================================
# CONVERSATION HISTORY (Postgres)
# =============================================================================
# Options: none | postgres
HISTORY_STORE=none
# Server-only Postgres URL (never sent to the browser). Same schema on both targets:
# - Docker:   docker compose --profile history up -d postgres, then
#             uv run python scripts/apply_migrations.py
#             HISTORY_DB_URL=postgresql://techfiling:<POSTGRES_PASSWORD>@127.0.0.1:5432/techfiling
#             (use 127.0.0.1: on Windows "localhost" tries IPv6 first and stalls)
# - Supabase: pooler URL, then uv run python scripts/apply_migrations.py --supabase
#             HISTORY_DB_URL=postgresql://postgres.xxxxx:password@host:6543/postgres?sslmode=require
# SUPABASE_DB_URL is still accepted as a fallback name.
# HISTORY_DB_URL=
# HISTORY_DB_POOL_SIZE=5
# Password for the Docker postgres service; use a URL-safe value (openssl rand -hex 24).
# POSTGRES_PASSWORD=
# docker compose points the backend at the postgres service and ignores HISTORY_DB_URL /
# SUPABASE_DB_URL; set this to use another database from the container (e.g. the Supabase
# pooler URL once you switch).
# DOCKER_HISTORY_DB_URL=
# Dev only, while Supabase auth is off: fixed UUID that owns saved history
# (python -c "import uuid; print(uuid.uuid4())"). Ignored with auth on; rejected in prod.
# HISTORY_DEV_USER_ID=

# Research-chat graph state (clarification pauses, follow-up context).
# memory: lost on restart. postgres: kept in HISTORY_DB_URL (tables created at startup);
# if the database is unreachable at startup, /chat is disabled (503), /questions still works.
AGENT_CHECKPOINTER=memory

# Reported XBRL figures for numeric answers (revenue, net income, EPS, ...).
# off: numbers come from retrieval only. postgres: loads the financial_facts table from
# HISTORY_DB_URL at startup; fill it after each ingestion run with
#   uv run python scripts/load_facts.py   (links to the chunk run of QDRANT_COLLECTION)
# Empty table, unreachable database or a different QDRANT_COLLECTION -> WARNING, runs as off.
FACTS_STORE=off

# =============================================================================
# API KEYS
# =============================================================================
# Only fill in the keys for providers you plan to use

# Hugging Face Inference API (get from https://huggingface.co/settings/tokens).
# REQUIRED in this mode; startup fails without it. Token needs "Make calls to
# Inference Providers" permission.
HUGGINGFACE_API_KEY=

# OpenAI API (get from https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API (get from https://console.anthropic.com/)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google AI API (get from https://makersuite.google.com/app/apikey)
# GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# OLLAMA CONFIGURATION
# =============================================================================
# Ollama server URL (default: local installation). Unused in this mode unless
# GENERATION_EXECUTION_MODE=local with LLM_PROVIDER=ollama, or AGENT_LLM_PROVIDER=ollama.
OLLAMA_HOST=http://localhost:11434
# Context window requested from Ollama by /questions and the research agent. The server
# default (often 4096) is too small for research synthesis; both use the same value so the
# model is not reloaded between calls. Leave empty for the server default.
OLLAMA_NUM_CTX=16384

# =============================================================================
# HUGGING FACE CONFIGURATION (used by huggingface_api mode)
# =============================================================================
# Inference provider for generation ("auto" picks one serving HUGGINGFACE_MODEL)
HUGGINGFACE_PROVIDER=auto

# Inference provider for embeddings (EMBEDDING_MODEL)
HUGGINGFACE_EMBEDDING_PROVIDER=hf-inference

# Reranker endpoint. "{model}" is replaced by the active reranker model.
# - Serverless:            https://router.huggingface.co/hf-inference/models/{model}
# - Dedicated TEI endpoint: https://<your-endpoint>.endpoints.huggingface.cloud/rerank
#   (URLs ending in /rerank use the TEI {"query", "texts"} format)
HUGGINGFACE_RERANKER_URL=https://router.huggingface.co/hf-inference/models/{model}

# Request timeout in seconds
HUGGINGFACE_TIMEOUT=120

# =============================================================================
# EVALUATION
# =============================================================================
# DeepEval judge model (OpenAI; requires OPENAI_API_KEY)
DEEPEVAL_JUDGE_MODEL=gpt-4o-mini

# =============================================================================
# HARDWARE CONFIGURATION
# =============================================================================
# Compute device for embeddings and local models
# Options: "cuda" | "cpu" | "auto"
# - cuda: Force GPU (requires NVIDIA GPU with CUDA)
# - cpu: Force CPU (slower but always works)
# - auto: Automatically detect best available device
DEVICE=auto

# =============================================================================
# EMBEDDING & RETRIEVAL MODELS
# =============================================================================
# Embedding model (same name in local and huggingface_api modes).
# Changing it requires re-embedding the chunk run (RUN_DIRECTORY).
# The Qdrant collection below was embedded locally with this model; querying it through
# the API only logs a backend-parity warning.
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Cross-encoder model for reranking (served by HF Inference "text-ranking")
RERANKER_MODEL=cross-encoder/ettin-reranker-150m-v1

# Production reranker (used when ENVIRONMENT=prod)
RERANKER_MODEL_PROD=cross-encoder/ettin-reranker-150m-v1

# =============================================================================
# RETRIEVAL PARAMETERS
# =============================================================================
# Dense weight in hybrid retrieval (0=BM25 only, 1=dense only)
RETRIEVAL_ALPHA=0.7

# Number of candidates to retrieve before reranking
RETRIEVAL_K=50

# Number of chunks passed to LLM after reranking
CONTEXT_K=5

# =============================================================================
# VECTOR STORE
# =============================================================================
# Retrieval index backend.
# - numpy:  embeddings_gpu_base.npy + in-memory BM25 from RUN_DIRECTORY (default)
# - qdrant: server-side dense + sparse (BM25) hybrid search with RRF fusion.
#           Start it with `docker compose up -d qdrant`, then load an existing run once with
#           `uv run python scripts/migrate_npy_to_qdrant.py` (no re-embedding).
# docker-compose.yml overrides QDRANT_URL for the backend container.
VECTOR_STORE=qdrant
QDRANT_URL=http://127.0.0.1:6333
# Embedded on-disk Qdrant (no Docker); overrides QDRANT_URL when set.
QDRANT_PATH=
# One collection per embedding model/version (built from RUN_DIRECTORY below)
QDRANT_COLLECTION=techfiling_20261031T133214Z
# Docker only: false builds the backend image without data/ (needs VECTOR_STORE=qdrant)
# INCLUDE_DATA=true
# Required when the Qdrant server is secured / Qdrant Cloud
# QDRANT_API_KEY=
# QDRANT_TIMEOUT=30

# =============================================================================
# PATHS
# =============================================================================
# Base data directory (relative to project root or absolute)
DATA_DIR=data

# Directory for cached sentence transformer models
MODEL_CACHE_DIR=models/sentence_transformers

# Directory containing chunk data
CHUNKS_DIR=data/chunks

# Active chunking run directory (relative to project root)
# Ingestion run behind QDRANT_COLLECTION (bge-base-en-v1.5, 7563 chunks)
RUN_DIRECTORY=data/chunks/2026-10-31_19-00-27

# =============================================================================
# LOGGING
# =============================================================================
# Options: "DEBUG" | "INFO" | "WARNING" | "ERROR"
LOG_LEVEL=INFO
# Every line carries the correlation ids ([req=... turn=...] in text; request_id, thread_id,
# turn_id fields in JSON), so one user turn can be followed across the API, the agent,
# retrieval, logs/metrics and its trace file.
# - text: readable lines (local)
# - json: one JSON object per line on stdout for a log collector (production)
LOG_FORMAT=text
# Optional: also write logs to a rotating file (leave empty in containers; stdout is enough)
LOG_FILE=logs/app.log

# =============================================================================
# OBSERVABILITY (latency / cost / reliability)
# =============================================================================
# One JSONL record per /questions request in METRICS_DIR/queries-YYYY-MM-DD.jsonl
METRICS_ENABLED=true
METRICS_DIR=logs/metrics
# First N requests per process are tagged cold (the one that loads the retriever always is)
METRICS_COLD_REQUESTS=2
# Retries of a failed LLM call (0 = off) with exponential backoff
LLM_MAX_RETRIES=0
LLM_RETRY_BACKOFF_SECONDS=1.0
# Override built-in token prices (USD per 1M tokens); local Ollama is free per token
# LLM_INPUT_PRICE_PER_1M=
# LLM_OUTPUT_PRICE_PER_1M=
# Hourly cost of the machine running local models (GPU VM, amortised workstation, ...)
LOCAL_COMPUTE_COST_PER_HOUR=0.0
