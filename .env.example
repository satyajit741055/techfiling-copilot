# =============================================================================
# TechFiling Copilot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# The .env file should NOT be committed to version control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your settings
# =============================================================================

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Options: "dev" or "prod"
# - dev: Uses lighter models, more verbose logging
# - prod: Uses production-quality models, optimized settings
ENVIRONMENT=dev

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# Primary LLM provider to use
# Options: "ollama" | "huggingface" | "openai" | "anthropic" | "google"
LLM_PROVIDER=ollama

# Override the default model for your provider (optional)
# If not set, uses the provider-specific default below
# LLM_MODEL=

# Provider-specific default models (customize as needed)
OLLAMA_MODEL=qwen2.5-7b-instruct:latest
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GOOGLE_MODEL=gemini-1.5-pro

# Generation parameters
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# =============================================================================
# API KEYS
# =============================================================================
# Only fill in the keys for providers you plan to use

# Hugging Face Inference API (get from https://huggingface.co/settings/tokens)
# HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API (get from https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API (get from https://console.anthropic.com/)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google AI API (get from https://makersuite.google.com/app/apikey)
# GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# OLLAMA CONFIGURATION
# =============================================================================
# Ollama server URL (default: local installation)
OLLAMA_HOST=http://localhost:11434

# =============================================================================
# HUGGING FACE CONFIGURATION
# =============================================================================
# Hugging Face Inference API base URL
HUGGINGFACE_API_URL=https://api-inference.huggingface.co/models

# =============================================================================
# HARDWARE CONFIGURATION
# =============================================================================
# Compute device for embeddings and local models
# Options: "cuda" | "cpu" | "auto"
# - cuda: Force GPU (requires NVIDIA GPU with CUDA)
# - cpu: Force CPU (slower but always works)
# - auto: Automatically detect best available device
DEVICE=auto

# =============================================================================
# EMBEDDING & RETRIEVAL MODELS
# =============================================================================
# Sentence transformer model for creating embeddings
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Cross-encoder model for reranking (dev uses lighter model)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Production reranker (higher quality, used when ENVIRONMENT=prod)
RERANKER_MODEL_PROD=cross-encoder/ettin-reranker-150m-v1

# =============================================================================
# RETRIEVAL PARAMETERS
# =============================================================================
# Dense weight in hybrid retrieval (0=BM25 only, 1=dense only)
RETRIEVAL_ALPHA=0.85

# Number of candidates to retrieve before reranking
RETRIEVAL_K=50

# Number of chunks passed to LLM after reranking
CONTEXT_K=5

# =============================================================================
# PATHS
# =============================================================================
# Base data directory (relative to project root or absolute)
DATA_DIR=data

# Directory for cached sentence transformer models
MODEL_CACHE_DIR=models/sentence_transformers

# Directory containing chunk data
CHUNKS_DIR=data/chunks

# Active chunking run directory (relative to project root)
# 1200/200/900 chars with pseudo-heading boundaries; tuned for hybrid (alpha 0.85) + ettin reranker
RUN_DIRECTORY=data/chunks/2026-10-20_16-33-24

# =============================================================================
# LOGGING
# =============================================================================
# Options: "DEBUG" | "INFO" | "WARNING" | "ERROR"
LOG_LEVEL=INFO
